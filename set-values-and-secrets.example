pt secrets set openrouter-api-key <openrouter_api_key>
pt secrets set langchain-api-key <langchain_api_key>

# UPM open-weights vLLM cluster (RQ1). The ngrok URL rotates on every pod
# restart — re-run upm_vllm_startup.sh and update vllm-base-url after each.
# vllm-basic-auth accepts either `user:pass` or `Basic <base64(user:pass)>`.
pt secrets set vllm-base-url <https://...ngrok-free.dev/v1>
pt secrets set vllm-basic-auth <user:pass>

# Per-provider concurrency caps for the parallel run executor.
# OpenRouter spreads load across many GPUs — 10 concurrent calls is safe.
# UPM A100 vLLM: ~4 for a 7B model, drop to 1 for a 70B Q4 model (weights fill the card).
pt values set openrouter-concurrency 10
pt values set vllm-concurrency 4